+    (h0 : PowerSeries.constantCoeff f = 0) (h1 : PowerSeries.coeff 1 f ≠ 0) :
+    (HahnSeries.ofPowerSeries ℤ F f).orderTop = (1 : ℤ) := by
+  apply laurent_orderTop_eq_of_coeff
+  · intro j hj
+    by_cases hj0 : j < 0
+    · exact laurent_ofPowerSeries_coeff_neg f hj0
+    · have hj_eq : j = 0 := by omega
+      subst j
+      change (HahnSeries.ofPowerSeries ℤ F f).coeff ((0 : ℕ) : ℤ) = 0
+      rw [HahnSeries.ofPowerSeries_apply_coeff, PowerSeries.coeff_zero_eq_constantCoeff_apply]
+      exact h0
+  · change (HahnSeries.ofPowerSeries ℤ F f).coeff ((1 : ℕ) : ℤ) ≠ 0
+    rw [HahnSeries.ofPowerSeries_apply_coeff]
+    exact h1
+
+private lemma ofPowerSeries_orderTop_zero_of_unit (f : PowerSeries F) (hf : IsUnit f) :
+    (HahnSeries.ofPowerSeries ℤ F f).orderTop = (0 : ℤ) := by
+  apply laurent_orderTop_eq_of_coeff
+  · intro j hj
+    exact laurent_ofPowerSeries_coeff_neg f hj
+  · have h0 : PowerSeries.constantCoeff f ≠ 0 :=
+      (PowerSeries.isUnit_iff_constantCoeff.mp hf).ne_zero
+    change (HahnSeries.ofPowerSeries ℤ F f).coeff ((0 : ℕ) : ℤ) ≠ 0
+    rw [HahnSeries.ofPowerSeries_apply_coeff, PowerSeries.coeff_zero_eq_constantCoeff_apply]
+    exact h0
