+  have h := map_zsmul (WeierstrassCurve.Jacobian.Point.toAffineAddEquiv (W_KE W))
+    m (WeierstrassCurve.Jacobian.Point.fromAffine
+      (Affine.Point.some x₀ y₀ h_ns))
+  rw [WeierstrassCurve.Jacobian.Point.toAffineAddEquiv_apply] at h
+  rw [show WeierstrassCurve.Jacobian.Point.toAffineAddEquiv (W_KE W)
+    (WeierstrassCurve.Jacobian.Point.fromAffine _) =
+    WeierstrassCurve.Jacobian.Point.toAffineLift
+      (WeierstrassCurve.Jacobian.Point.fromAffine _) from rfl] at h
+  have h2 : WeierstrassCurve.Jacobian.Point.toAffineLift
+      (WeierstrassCurve.Jacobian.Point.fromAffine
+        (Affine.Point.some x₀ y₀ h_ns)) =
+      Affine.Point.some x₀ y₀ h_ns := by
+    rw [← WeierstrassCurve.Jacobian.Point.toAffineAddEquiv_apply]
+    exact h_inv
+  rw [h2] at h
+  exact h.symm
+
+omit [DecidableEq F] [W.toAffine.IsElliptic] in
+/-- The `toAffineLift` of the `m`-fold Jacobian multiple of `fromAffine (.some x₀ y₀ _)` is the
+    plain `toAffine` of the explicit division-polynomial coordinate vector `smulEval`. -/
+private lemma toAffineLift_zsmul_fromAffine_eq_toAffine (m : ℤ) {x₀ y₀ : KE}
+    (h_ns : (W_KE W).toAffine.Nonsingular x₀ y₀) :
+    WeierstrassCurve.Jacobian.Point.toAffineLift
+        (m • WeierstrassCurve.Jacobian.Point.fromAffine
+          (Affine.Point.some x₀ y₀ h_ns)) =
+      WeierstrassCurve.Jacobian.Point.toAffine (W_KE W)
+        (smulEval (W_KE W) x₀ y₀ m) := by
+  simp only [WeierstrassCurve.Jacobian.Point.toAffineLift]
+  rw [WeierstrassCurve.zsmul_eq_smulEval (W := W_KE W) h_ns m]
+  rfl
+
+omit [DecidableEq F] in
+/-- **Main theorem (Silverman III.4.2)**: for every `n ≠ 0`, `n • genericPoint W`
+    has coordinates `(mulByInt_x W n, mulByInt_y W n)`. -/
+theorem zsmul_genericPoint_eq (n : ℤ) (hn : n ≠ 0) :
+    ∃ h : (W_KE W).toAffine.Nonsingular (mulByInt_x W n) (mulByInt_y W n),
+      n • genericPoint W =
+        Affine.Point.some (mulByInt_x W n) (mulByInt_y W n) h := by
+  have hψ : ψ_ff W n ≠ 0 := ψ_ff_ne_zero W hn
+  have hns := generic_nonsingular W
+  have hZ : smulEval (W_KE W) (x_gen W) (y_gen W) n 2 ≠ 0 := by
+    rw [smulEval_generic_Z]; exact hψ
+  -- The `m`-fold multiple is nonsingular in Jacobian coordinates.
+  have h_ns_smulEval := jacobian_nonsingular_smulEval W n hns
+  -- Reading off the affine nonsingularity from `Z ≠ 0`, then identifying the
+  -- generic-point coordinates with `Φ_ff / ψ_ff²` etc. and finally `mulByInt_x`.
+  have h_ns_affine :
+      (W_KE W).toAffine.Nonsingular
+        (smulEval (W_KE W) (x_gen W) (y_gen W) n 0 /
+          smulEval (W_KE W) (x_gen W) (y_gen W) n 2 ^ 2)
+        (smulEval (W_KE W) (x_gen W) (y_gen W) n 1 /
+          smulEval (W_KE W) (x_gen W) (y_gen W) n 2 ^ 3) :=
+    (WeierstrassCurve.Jacobian.nonsingular_of_Z_ne_zero hZ).mp h_ns_smulEval
+  rw [smulEval_generic_X, smulEval_generic_Y, smulEval_generic_Z] at h_ns_affine
+  have h_x_eq : Φ_ff W n / ψ_ff W n ^ 2 = mulByInt_x W n := by
+    change _ = Φ_ff W n / ΨSq_ff W n
+    rw [ψ_ff_sq_eq_ΨSq_ff]
+  rw [h_x_eq] at h_ns_affine
+  -- Re-type the nonsingularity proof at the *folded* `mulByInt_y W n` (defeq to
+  -- `ω_ff W n / ψ_ff W n ^ 3`), so the `Point.some` ascriptions in the goal below
+  -- stay type-correct at implicit transparency and `some.injEq` can match.
+  have h_ns_affine' :
+      (W_KE W).toAffine.Nonsingular (mulByInt_x W n) (mulByInt_y W n) := h_ns_affine
+  refine ⟨h_ns_affine', ?_⟩
+  -- Transport `n • genericPoint` across the affine ↔ Jacobian equivalence and unfold to
+  -- the explicit `smulEval` coordinate vector, then read off both coordinates.
+  change n • Affine.Point.some (x_gen W) (y_gen W) hns = _
+  rw [zsmul_some_eq_toAffineLift_fromAffine W n hns,
+    toAffineLift_zsmul_fromAffine_eq_toAffine W n hns,
+    WeierstrassCurve.Jacobian.Point.toAffine_of_Z_ne_zero h_ns_smulEval hZ,
+    Affine.Point.some.injEq]
+  refine ⟨?_, ?_⟩
+  · rw [smulEval_generic_X, smulEval_generic_Z]
+    exact h_x_eq
+  · rw [smulEval_generic_Y, smulEval_generic_Z]
+    rfl
+
+omit [DecidableEq F] in
+/-- **Group-law successor step on the generic point** (Silverman III.5.3 prep): chord-addition
+    of `P = (x_gen, y_gen)` against `[m]P = (mulByInt_x m, mulByInt_y m)` realises the
+    `[m+1]`-coordinates, stated as `addX`/`addY` identities.
+
+    The secant slope is written out as `(y_gen - mulByInt_y m)/(x_gen - mulByInt_x m)` rather
+    than via the `slope` function, whose `if x₁ = x₂` branch carries a `DecidableEq K(E)`
+    instance that diamonds across import boundaries (`AdditionPullback`'s
+    `instDecidableEqFunctionField` vs mathlib's `FractionRing.instDecidableEq`). With `slope`
+    eliminated the conclusion uses only instance-stable `K(E)` field operations, so it is
+    consumed verbatim in `MulByIntAddRecurrence`. -/
+theorem addX_addY_genericPoint_mulByInt_eq_succ (m : ℤ) (hm : m ≠ 0) (hm1 : m + 1 ≠ 0)
+    (hx_ne : x_gen W ≠ mulByInt_x W m) :
+    (W_KE W).toAffine.addX (x_gen W) (mulByInt_x W m)
+        ((y_gen W - mulByInt_y W m) / (x_gen W - mulByInt_x W m))
+          = mulByInt_x W (m + 1) ∧
+      (W_KE W).toAffine.addY (x_gen W) (mulByInt_x W m) (y_gen W)
+          ((y_gen W - mulByInt_y W m) / (x_gen W - mulByInt_x W m))
+            = mulByInt_y W (m + 1) := by
+  obtain ⟨h_ns_m, h_m⟩ := zsmul_genericPoint_eq W m hm
+  obtain ⟨h_ns_m1, h_m1⟩ := zsmul_genericPoint_eq W (m + 1) hm1
+  have key : Affine.Point.some (mulByInt_x W (m + 1)) (mulByInt_y W (m + 1)) h_ns_m1
+      = genericPoint W + Affine.Point.some (mulByInt_x W m) (mulByInt_y W m) h_ns_m := by
+    rw [← h_m, ← h_m1, add_comm m 1, one_add_zsmul]
+  rw [show genericPoint W
+        = Affine.Point.some (x_gen W) (y_gen W) (generic_nonsingular W) from rfl,
+    Affine.Point.add_of_X_ne hx_ne, Affine.Point.some.injEq,
+    WeierstrassCurve.Affine.slope_of_X_ne hx_ne] at key
+  exact ⟨key.1.symm, key.2.symm⟩
+
+
+omit [DecidableEq F] in
+private theorem zsmul_genericPoint_ne_zero (n : ℤ) (hn : n ≠ 0) :
+    n • genericPoint W ≠ 0 := by
+  obtain ⟨h, heq⟩ := zsmul_genericPoint_eq W n hn
+  rw [heq]
+  intro hzero
+  cases hzero
+
+omit [DecidableEq F] in
+private theorem x_gen_ne_mulByInt_x (n : ℤ) (hn : 2 ≤ n) :
+    x_gen W ≠ mulByInt_x W n := by
+  intro heq
+  obtain ⟨hns, hz⟩ := zsmul_genericPoint_eq W n (by omega)
+  have hpoints := (Affine.Point.X_eq_iff
+    (h₁ := generic_nonsingular W) (h₂ := hns)).mp heq
+  change genericPoint W = _ ∨ genericPoint W = -_ at hpoints
+  rw [← hz] at hpoints
+  rcases hpoints with hpos | hneg
+  · apply zsmul_genericPoint_ne_zero W (n - 1) (by omega)
+    rw [sub_smul, one_zsmul, ← hpos, sub_self]
+  · apply zsmul_genericPoint_ne_zero W (n + 1) (by omega)
+    rw [add_smul, one_zsmul]
+    exact (congrArg (fun Q ↦ n • genericPoint W + Q) hneg).trans (add_neg_cancel _)
+
+private theorem map_wronskian {R S : Type*} [CommRing R] [CommRing S]
+    (V : WeierstrassCurve R) (f : R →+* S) (n : ℤ) :
+    Polynomial.map f (Polynomial.derivative (V.Φ n) * V.ΨSq n -
+      V.Φ n * Polynomial.derivative (V.ΨSq n)) =
+      Polynomial.derivative ((V.map f).Φ n) * (V.map f).ΨSq n -
+        (V.map f).Φ n * Polynomial.derivative ((V.map f).ΨSq n) := by
+  rw [WeierstrassCurve.map_Φ, WeierstrassCurve.map_ΨSq,
+    Polynomial.derivative_map, Polynomial.derivative_map,
+    Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_mul]
+
+private theorem map_wronskian_rhs {R S : Type*} [CommRing R] [CommRing S]
+    (V : WeierstrassCurve R) (f : R →+* S) (n : ℤ) :
+    Polynomial.map f (Polynomial.C (n : R) * V.preΨ (2 * n)) =
+      Polynomial.C (n : S) * (V.map f).preΨ (2 * n) := by
+  rw [Polynomial.map_mul, Polynomial.map_C, map_intCast, WeierstrassCurve.map_preΨ]
+
+omit [DecidableEq F] [W.toAffine.IsElliptic] in
+private theorem wronskian_specialize_universal (n : ℤ)
+    (h : Polynomial.derivative (Universal.pointedCurve.Φ n) * Universal.pointedCurve.ΨSq n -
+      Universal.pointedCurve.Φ n * Polynomial.derivative (Universal.pointedCurve.ΨSq n) =
+      Polynomial.C (n : Universal.Field) * Universal.pointedCurve.preΨ (2 * n)) :
+    Polynomial.derivative (W.Φ n) * W.ΨSq n - W.Φ n * Polynomial.derivative (W.ΨSq n) =
+      Polynomial.C (n : F) * W.preΨ (2 * n) := by
+  have hU : Polynomial.derivative (Universal.curve.Φ n) * Universal.curve.ΨSq n -
+      Universal.curve.Φ n * Polynomial.derivative (Universal.curve.ΨSq n) =
+      Polynomial.C (n : MvPolynomial Coeff ℤ) * Universal.curve.preΨ (2 * n) := by
+    apply Polynomial.map_injective (algebraMap (MvPolynomial Coeff ℤ) Universal.Field)
+      Universal.algebraMap_field_injective
+    rw [map_wronskian, map_wronskian_rhs]
+    exact h
+  have hF := congrArg (Polynomial.map W.specialize) hU
+  rw [map_wronskian, map_wronskian_rhs] at hF
+  have hspecial : WeierstrassCurve.map Universal.curve W.specialize = W :=
+    WeierstrassCurve.map_specialize W
+  exact (congrArg (fun V : WeierstrassCurve F ↦
+    Polynomial.derivative (V.Φ n) * V.ΨSq n - V.Φ n * Polynomial.derivative (V.ΨSq n) =
+      Polynomial.C (n : F) * V.preΨ (2 * n)) hspecial).mp hF
+
+private noncomputable def Dω (f : KE) : KE :=
+  (exists_smul_eq_of_finrank_eq_one (kaehler_rank_one W.toAffine)
+    (invariantDifferential_ne_zero W.toAffine) (KaehlerDifferential.D F KE f)).choose
+
+
+private theorem Dω_spec (f : KE) :
+    KaehlerDifferential.D F KE f = Dω W f • invariantDifferential W.toAffine :=
+  (exists_smul_eq_of_finrank_eq_one (kaehler_rank_one W.toAffine)
+    (invariantDifferential_ne_zero W.toAffine) (KaehlerDifferential.D F KE f)).choose_spec.symm
+
+
+private theorem Dω_eq_of_smul {f : KE} {c : KE}
+    (h : c • invariantDifferential W.toAffine = KaehlerDifferential.D F KE f) :
+    c = Dω W f :=
+  omegaPullbackCoeff_unique W c (Dω W f) (h.trans (Dω_spec W f))
+
+
+@[simp] private theorem Dω_add (f g : KE) : Dω W (f + g) = Dω W f + Dω W g := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [add_smul, ← Dω_spec, ← Dω_spec, map_add]
+
+
+@[simp] private theorem Dω_algebraMap (a : F) : Dω W (algebraMap F KE a) = 0 := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [zero_smul, (KaehlerDifferential.D F KE).map_algebraMap]
+
+
+@[simp] private theorem Dω_zero : Dω W (0 : KE) = 0 := by
+  simpa using Dω_algebraMap W (0 : F)
+
+
+@[simp] private theorem Dω_mul (f g : KE) : Dω W (f * g) = f * Dω W g + g * Dω W f := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [add_smul, mul_smul, mul_smul, ← Dω_spec, ← Dω_spec,
+    (KaehlerDifferential.D F KE).leibniz, add_comm]
+
+
+@[simp] private theorem Dω_smul (a : F) (f : KE) : Dω W (a • f) = a • Dω W f := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [smul_assoc, ← Dω_spec, (KaehlerDifferential.D F KE).map_smul]
+
+
+@[simp] private theorem Dω_sub (f g : KE) : Dω W (f - g) = Dω W f - Dω W g := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [sub_smul, ← Dω_spec, ← Dω_spec, map_sub]
+
+
+@[simp] private theorem Dω_neg (f : KE) : Dω W (-f) = -Dω W f := by
+  rw [show (-f : KE) = 0 - f by ring, Dω_sub, Dω_zero, zero_sub]
+
+
+private theorem Dω_pow (f : KE) (n : ℕ) : Dω W (f ^ n) = (n : KE) * f ^ (n - 1) * Dω W f := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [(KaehlerDifferential.D F KE).leibniz_pow, Dω_spec W f, smul_smul,
+    ← Nat.cast_smul_eq_nsmul KE, smul_smul, mul_assoc]
+
+
+private theorem Dω_inv (f : KE) : Dω W f⁻¹ = -f⁻¹ ^ 2 * Dω W f := by
+  refine (Dω_eq_of_smul W ?_).symm
+  rw [mul_smul, ← Dω_spec, (KaehlerDifferential.D F KE).leibniz_inv, neg_smul]
+
+
+private theorem Dω_pullback_x (α : Isogeny W.toAffine W.toAffine) :
+    Dω W (α.pullback (x_gen W)) = alpha_star_u W α * omegaPullbackCoeff W α := by
+  apply (Dω_eq_of_smul W ?_).symm
+  rw [mul_smul, omegaPullbackCoeff_spec]
+  change alpha_star_u W α • ((alpha_star_u W α)⁻¹ •
+    KaehlerDifferential.D F KE (α.pullback (x_gen W))) = _
+  rw [smul_smul, mul_inv_cancel₀ (by
+    rw [alpha_star_u_eq]
+    exact fun h ↦ u_gen_ne_zero W (α.pullback_injective (by rw [h, map_zero]))), one_smul]
+
+private theorem Dω_weierstrass (x y : KE)
+    (heq : y ^ 2 + algebraMap F KE W.a₁ * x * y + algebraMap F KE W.a₃ * y =
+      x ^ 3 + algebraMap F KE W.a₂ * x ^ 2 + algebraMap F KE W.a₄ * x +
+        algebraMap F KE W.a₆) :
+    (2 * y + algebraMap F KE W.a₁ * x + algebraMap F KE W.a₃) * Dω W y =
+      (3 * x ^ 2 + 2 * algebraMap F KE W.a₂ * x + algebraMap F KE W.a₄ -
+        algebraMap F KE W.a₁ * y) * Dω W x := by
+  have hd := congrArg (Dω W) heq
+  simp only [Dω_add, Dω_mul, Dω_pow, Dω_algebraMap, mul_zero,
+    add_zero, Nat.cast_ofNat, Nat.reduceSub, pow_one] at hd
+  linear_combination hd
+
+private theorem Dω_pullback_y (α : Isogeny W.toAffine W.toAffine) :
+    Dω W (α.pullback (y_gen W)) =
+      (3 * (α.pullback (x_gen W)) ^ 2 +
+        2 * algebraMap F KE W.a₂ * α.pullback (x_gen W) + algebraMap F KE W.a₄ -
+        algebraMap F KE W.a₁ * α.pullback (y_gen W)) * omegaPullbackCoeff W α := by
+  have hgen := generic_equation W
+  rw [Affine.equation_iff] at hgen
+  change y_gen W ^ 2 + algebraMap F KE W.a₁ * x_gen W * y_gen W +
+    algebraMap F KE W.a₃ * y_gen W = x_gen W ^ 3 +
+      algebraMap F KE W.a₂ * x_gen W ^ 2 + algebraMap F KE W.a₄ * x_gen W +
+        algebraMap F KE W.a₆ at hgen
+  have heq := congrArg α.pullback hgen
+  simp only [map_add, map_mul, map_pow, AlgHom.commutes] at heq
+  have hd := Dω_weierstrass W _ _ heq
+  rw [Dω_pullback_x] at hd
+  have hu : alpha_star_u W α ≠ 0 := by
+    rw [alpha_star_u_eq]
+    exact fun h ↦ u_gen_ne_zero W (α.pullback_injective (by rw [h, map_zero]))
+  apply mul_left_cancel₀ hu
+  change alpha_star_u W α * Dω W (α.pullback (y_gen W)) = _ at hd
+  rw [hd]
+  ring
+
+private theorem Dω_x_gen : Dω W (x_gen W) = u_gen W := by
+  apply (Dω_eq_of_smul W ?_).symm
+  change u_gen W • ((u_gen W)⁻¹ • KaehlerDifferential.D F KE (x_gen W)) = _
+  rw [smul_smul, mul_inv_cancel₀ (u_gen_ne_zero W), one_smul]
+
+private theorem Dω_y_gen :
+    Dω W (y_gen W) = 3 * x_gen W ^ 2 + 2 * algebraMap F KE W.a₂ * x_gen W +
+      algebraMap F KE W.a₄ - algebraMap F KE W.a₁ * y_gen W := by
+  have hgen := generic_equation W
+  rw [Affine.equation_iff] at hgen
+  change y_gen W ^ 2 + algebraMap F KE W.a₁ * x_gen W * y_gen W +
+    algebraMap F KE W.a₃ * y_gen W = x_gen W ^ 3 +
+      algebraMap F KE W.a₂ * x_gen W ^ 2 + algebraMap F KE W.a₄ * x_gen W +
+        algebraMap F KE W.a₆ at hgen
+  have hd := Dω_weierstrass W _ _ hgen
+  rw [Dω_x_gen] at hd
+  apply mul_left_cancel₀ (u_gen_ne_zero W)
+  change u_gen W * Dω W (y_gen W) = _ at hd
+  rw [hd]
+  ring
+
+private theorem chord_derivative_identity {L : Type*} [Field L]
+    (a1 a2 a3 a4 a6 x y X Y A B : L) (hden : x - X ≠ 0)
+    (hW : y ^ 2 + a1 * x * y + a3 * y = x ^ 3 + a2 * x ^ 2 + a4 * x + a6)
+    (hP : Y ^ 2 + a1 * X * Y + a3 * Y = X ^ 3 + a2 * X ^ 2 + a4 * X + a6) :
+    let l := (y - Y) / (x - X)
+    let xt := l ^ 2 + a1 * l - a2 - x - X
+    let yt := -l * (xt - x) - y - a1 * xt - a3
+    (2 * l + a1) * (((3 * x ^ 2 + 2 * a2 * x + a4 - a1 * y) * A -
+      (3 * X ^ 2 + 2 * a2 * X + a4 - a1 * Y) * B) / (x - X) -
+      (y - Y) * ((2 * y + a1 * x + a3) * A - (2 * Y + a1 * X + a3) * B) /
+        (x - X) ^ 2) - (2 * y + a1 * x + a3) * A - (2 * Y + a1 * X + a3) * B =
+      (2 * yt + a1 * xt + a3) * (A + B) := by
+  dsimp only
+  field_simp [hden]
+  linear_combination
+    -((A - B) * (a1 * (x - X) + 2 * (y - Y))) * hW +
+      ((A - B) * (a1 * (x - X) + 2 * (y - Y))) * hP
+
+private theorem Dω_div (f g : KE) :
+    Dω W (f / g) = Dω W f / g - f * Dω W g / g ^ 2 := by
+  rw [div_eq_mul_inv, Dω_mul, Dω_inv]
+  ring
+
+private theorem omega_mulByInt_succ (n : ℤ) (hn : 2 ≤ n) :
+    omegaPullbackCoeff W (mulByInt W.toAffine (n + 1)) =
+      1 + omegaPullbackCoeff W (mulByInt W.toAffine n) := by
+  have hn0 : n ≠ 0 := by omega
+  have hn1 : n + 1 ≠ 0 := by omega
+  have hxne := x_gen_ne_mulByInt_x W n hn
+  obtain ⟨hrecx, hrecy⟩ := addX_addY_genericPoint_mulByInt_eq_succ W n hn0 hn1 hxne
+  let α := mulByInt W.toAffine n
+  let β := mulByInt W.toAffine (n + 1)
+  have hxα : α.pullback (x_gen W) = mulByInt_x W n := mulByInt_pullback_x W n hn0
+  have hyα : α.pullback (y_gen W) = mulByInt_y W n := mulByInt_pullback_y W n hn0
+  have hDX := Dω_pullback_x W α
+  have hDY := Dω_pullback_y W α
+  rw [hxα] at hDX
+  rw [hxα, hyα] at hDY
+  have hgen := generic_equation W
+  rw [Affine.equation_iff] at hgen
+  change y_gen W ^ 2 + algebraMap F KE W.a₁ * x_gen W * y_gen W +
+    algebraMap F KE W.a₃ * y_gen W = x_gen W ^ 3 +
+      algebraMap F KE W.a₂ * x_gen W ^ 2 + algebraMap F KE W.a₄ * x_gen W +
+        algebraMap F KE W.a₆ at hgen
+  have himg := congrArg α.pullback hgen
+  simp only [map_add, map_mul, map_pow, AlgHom.commutes, hxα, hyα] at himg
+  have hpure := chord_derivative_identity
+    (algebraMap F KE W.a₁) (algebraMap F KE W.a₂) (algebraMap F KE W.a₃)
+    (algebraMap F KE W.a₄) (algebraMap F KE W.a₆)
+    (x_gen W) (y_gen W) (mulByInt_x W n) (mulByInt_y W n)
+    1 (omegaPullbackCoeff W α) (sub_ne_zero.mpr hxne) hgen himg
+  have ha₁ : (W_KE W).toAffine.a₁ = algebraMap F KE W.a₁ := rfl
+  have ha₂ : (W_KE W).toAffine.a₂ = algebraMap F KE W.a₂ := rfl
+  have ha₃ : (W_KE W).toAffine.a₃ = algebraMap F KE W.a₃ := rfl
+  have hDrec := congrArg (Dω W) hrecx
+  simp only [Affine.addX, ha₁, ha₂, Dω_sub, Dω_add, Dω_mul, Dω_pow, Dω_div,
+    Dω_algebraMap, Dω_x_gen, Dω_y_gen, hDX, hDY,
+    Nat.cast_ofNat, Nat.reduceSub, pow_one, mul_zero, add_zero, sub_zero] at hDrec
+  have hβD := Dω_pullback_x W β
+  rw [show β.pullback (x_gen W) = mulByInt_x W (n + 1) from
+    mulByInt_pullback_x W (n + 1) hn1] at hβD
+  have hualpha : alpha_star_u W α =
+      2 * mulByInt_y W n + algebraMap F KE W.a₁ * mulByInt_x W n + algebraMap F KE W.a₃ :=
+    alpha_star_u_mulByInt W n hn0
+  have hubeta : alpha_star_u W β =
+      2 * (W_KE W).toAffine.addY (x_gen W) (mulByInt_x W n) (y_gen W)
+        ((y_gen W - mulByInt_y W n) / (x_gen W - mulByInt_x W n)) +
+      algebraMap F KE W.a₁ * (W_KE W).toAffine.addX (x_gen W) (mulByInt_x W n)
+        ((y_gen W - mulByInt_y W n) / (x_gen W - mulByInt_x W n)) +
+      algebraMap F KE W.a₃ := by
+    rw [hrecx, hrecy]
+    exact alpha_star_u_mulByInt W (n + 1) hn1
+  have hu : alpha_star_u W β ≠ 0 := by
+    rw [alpha_star_u_eq]
+    exact fun h ↦ u_gen_ne_zero W (β.pullback_injective (by rw [h, map_zero]))
+  apply mul_left_cancel₀ hu
+  rw [← hβD, ← hDrec, hubeta, hualpha]
+  have huf : u_gen W = 2 * y_gen W + algebraMap F KE W.a₁ * x_gen W +
+      algebraMap F KE W.a₃ := rfl
+  simp only [huf, Affine.addY, Affine.negY, Affine.negAddY, Affine.addX, ha₁, ha₂, ha₃]
+  dsimp only [α] at hpure ⊢
+  simp only [div_eq_mul_inv] at hpure ⊢
+  convert hpure using 1 <;> ring
+
+private theorem omega_mulByInt_ge_two (n : ℤ) (hn : 2 ≤ n) :
+    omegaPullbackCoeff W (mulByInt W.toAffine n) = algebraMap F KE n := by
+  induction n, hn using Int.leInduction with
+  | base => exact omegaPullbackCoeff_mulByInt_two W
+  | succ k hk ih =>
+    rw [omega_mulByInt_succ W k hk, ih, Int.cast_add, Int.cast_one, map_add, map_one, add_comm]
+
+
+omit [DecidableEq F] in
+private theorem wronskian_ge_two_elliptic (n : ℤ) (hn2 : 2 ≤ n) :
+    Polynomial.derivative (W.Φ n) * W.ΨSq n - W.Φ n * Polynomial.derivative (W.ΨSq n) =
+    Polynomial.C ((n : ℤ) : F) * W.preΨ (2 * n) := by
+  classical
+  have hn : n ≠ 0 := by omega
+  have homega := omega_mulByInt_ge_two W n hn2
+  have hKE := divPoly_wronskian_identity_of_omega W n hn homega
+  have hbridge := preΨ_two_mul_u_eq_ΨSq_sq_mul_alpha_star_u W n hn
+  rw [mul_assoc, ← hbridge] at hKE
+  have hΦ_ff : Φ_ff W n = algebraMap (Polynomial F) KE (W.Φ n) :=
+    (IsScalarTower.algebraMap_apply (Polynomial F) W.toAffine.CoordinateRing KE (W.Φ n)).symm
+  have hΨSq_ff : ΨSq_ff W n = algebraMap (Polynomial F) KE (W.ΨSq n) :=
+    (IsScalarTower.algebraMap_apply (Polynomial F) W.toAffine.CoordinateRing KE (W.ΨSq n)).symm
+  rw [hΦ_ff, hΨSq_ff] at hKE
+  have hn_cast : algebraMap F KE (n : F) =
+      algebraMap (Polynomial F) KE (Polynomial.C ((n : ℤ) : F)) := by
+    rw [Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply F (Polynomial F) KE]
+  rw [hn_cast] at hKE
+  have hLHS : (algebraMap (Polynomial F) KE (Polynomial.derivative (W.Φ n)) *
+        algebraMap (Polynomial F) KE (W.ΨSq n) -
+      algebraMap (Polynomial F) KE (W.Φ n) *
+        algebraMap (Polynomial F) KE (Polynomial.derivative (W.ΨSq n))) =
+      algebraMap (Polynomial F) KE
+        (Polynomial.derivative (W.Φ n) * W.ΨSq n -
+          W.Φ n * Polynomial.derivative (W.ΨSq n)) := by
+    rw [map_sub, map_mul, map_mul]
+  have hRHS : algebraMap (Polynomial F) KE (Polynomial.C ((n : ℤ) : F)) *
+        algebraMap (Polynomial F) KE (W.preΨ (2 * n)) =
+      algebraMap (Polynomial F) KE (Polynomial.C ((n : ℤ) : F) * W.preΨ (2 * n)) := by
+    rw [map_mul]
+  rw [hLHS, ← mul_assoc, hRHS] at hKE
+  have hu := mul_right_cancel₀ (u_gen_ne_zero W) hKE
+  have hinj : Function.Injective (algebraMap (Polynomial F) KE) := by
+    rw [IsScalarTower.algebraMap_eq (Polynomial F) W.toAffine.CoordinateRing KE]
+    exact (IsFractionRing.injective W.toAffine.CoordinateRing KE).comp
+      Affine.CoordinateRing.algebraMap_poly_injective
+  exact hinj hu
+
+omit [DecidableEq F] [W.toAffine.IsElliptic] in
+theorem wronskian_ge_two (n : ℤ) (hn : 2 ≤ n) :
+    Polynomial.derivative (W.Φ n) * W.ΨSq n - W.Φ n * Polynomial.derivative (W.ΨSq n) =
+      Polynomial.C (n : F) * W.preΨ (2 * n) := by
+  classical
+  apply wronskian_specialize_universal W n
+  exact wronskian_ge_two_elliptic Universal.pointedCurve n hn
+
+
+end HasseWeil.WronskianProof
+
+namespace HasseWeil
+
+variable {F : Type*} [Field F] [DecidableEq F]
+variable (W : WeierstrassCurve F) [W.toAffine.IsElliptic]
+local notation "KE" => W.toAffine.FunctionField
+
+omit [DecidableEq F] [W.toAffine.IsElliptic] in
+/-- The natural-number Wronskian identity. The general case follows from chord induction
+on the universal smooth curve and specialization of the resulting polynomial identity. -/
+private lemma wronskian_Φ_ΨSq_nat (m : ℕ) :
+    Polynomial.derivative (W.Φ (m : ℤ)) * W.ΨSq (m : ℤ) -
+      W.Φ (m : ℤ) * Polynomial.derivative (W.ΨSq (m : ℤ)) =
+    Polynomial.C ((m : ℤ) : F) * W.preΨ (2 * (m : ℤ)) := by
+  match m with
+  | 0 => exact wronskian_Φ_ΨSq_zero W
+  | 1 => exact_mod_cast wronskian_Φ_ΨSq_one W
+  | 2 => exact_mod_cast wronskian_Φ_ΨSq_two W
+  | 3 => exact_mod_cast wronskian_Φ_ΨSq_three W
+  | 4 => exact_mod_cast wronskian_Φ_ΨSq_four W
+  | n + 5 =>
+    apply WronskianProof.wronskian_ge_two
+    omega
+
+omit [DecidableEq F] [W.toAffine.IsElliptic] in
+/-- The division polynomial Wronskian identity:
+    `Φ_n' · ΨSq_n - Φ_n · ΨSq_n' = n · preΨ(2n)` as polynomials in `F[X]`.
+
+    Reference: Silverman Exercise III.3.7.
+
+    Proved by reducing to the natural number case via `wronskian_Φ_ΨSq_neg_of`
+    (negation symmetry) and `wronskian_Φ_ΨSq_nat` (the natural-number case). -/
+theorem wronskian_Φ_ΨSq (n : ℤ) :
+    Polynomial.derivative (W.Φ n) * W.ΨSq n - W.Φ n * Polynomial.derivative (W.ΨSq n) =
+    Polynomial.C (n : F) * W.preΨ (2 * n) := by
+  rcases lt_or_ge n 0 with hneg | hpos
+  · -- n < 0: use negation symmetry on the positive case
+    have hm : (0 : ℤ) ≤ -n := by omega
+    obtain ⟨m, hm_eq⟩ := Int.eq_ofNat_of_zero_le hm
+    have hn_eq : n = -(m : ℤ) := by omega
+    rw [hn_eq]
+    exact wronskian_Φ_ΨSq_neg_of W (wronskian_Φ_ΨSq_nat W m)
+  · -- n ≥ 0: directly from wronskian_Φ_ΨSq_nat
+    obtain ⟨m, hm_eq⟩ := Int.eq_ofNat_of_zero_le hpos
+    subst hm_eq
+    exact wronskian_Φ_ΨSq_nat W m
+
+/-- The division polynomial Wronskian identity in K(E) (general `n`), via the
+    general polynomial-level identity `wronskian_Φ_ΨSq`.
+    Reference: Silverman Exercise III.3.7, III.5.3 -/
+theorem divPoly_wronskian_identity (n : ℤ) (hn : n ≠ 0) :
+    (algebraMap (Polynomial F) KE (Polynomial.derivative (W.Φ n)) *
+      ΨSq_ff W n -
+    Φ_ff W n *
+      algebraMap (Polynomial F) KE (Polynomial.derivative (W.ΨSq n))) *
+    u_gen W =
+    algebraMap F KE n *
+    ΨSq_ff W n ^ 2 *
+    alpha_star_u W (mulByInt W.toAffine n) :=
+  divPoly_wronskian_identity_of_poly W n hn (wronskian_Φ_ΨSq (W := W) n)
+
+/-- The pullback coefficient of multiplication by a nonzero integer is that integer.
+This follows from the general polynomial Wronskian identity (Silverman III.5.3). -/
+theorem omegaPullbackCoeff_mulByInt (n : ℤ) (hn : n ≠ 0) :
+    omegaPullbackCoeff W (mulByInt W.toAffine n) = algebraMap F KE n :=
+  omegaPullbackCoeff_mulByInt_of_poly W n hn (wronskian_Φ_ΨSq (W := W) n)
+
+end HasseWeil
