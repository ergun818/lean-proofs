+      IsGenuineWith W α
+        (((zsmulPointHom W r).comp (frobeniusW_KE W)) + zsmulPointHom W (-s)) ∧
+      omegaPullbackCoeff W α = algebraMap K W.toAffine.FunctionField (-s : K) ∧
+      (W_smooth W).ordAtInfty (α.pullback (x_gen W)) = ((-2 : ℤ) : WithTop ℤ) ∧
+      (W_smooth W).ordAtInfty (α.pullback (y_gen W)) = ((-3 : ℤ) : WithTop ℤ) := by
+  classical
+  let α₁ := (frobeniusIsog W).zsmul r
+  let α₂ := mulByInt W.toAffine (-s)
+  obtain ⟨M, hM, hMle, _⟩ := exists_ordAtInfty_mulByInt_x_eq_even_le_neg_two W r hr
+  have hq : (2 : ℤ) ≤ Fintype.card K := by
+    have hqnat : 2 ≤ Fintype.card K :=
+      Fintype.one_lt_card_iff_nontrivial.mpr (inferInstance : Nontrivial K)
+    exact_mod_cast hqnat
+  have hX₁ : (W_smooth W).ordAtInfty (α₁.pullback (x_gen W)) =
+      (((Fintype.card K : ℤ) * M) : WithTop ℤ) := by
+    have hx : α₁.pullback (x_gen W) = (mulByInt_x W r) ^ Fintype.card K := by
+      change (frobeniusIsog W).pullback ((mulByInt W.toAffine r).pullback (x_gen W)) = _
+      have hm : (mulByInt W.toAffine r).pullback (x_gen W) = mulByInt_x W r :=
+        mulByInt_pullback_x W r hr
+      rw [hm, frobeniusIsog_pullback_apply]
+    exact (congrArg (W_smooth W).ordAtInfty hx).trans
+      ((W_smooth W).ord_pow_concrete (mulByInt_x_ne_zero W r hr) M (Fintype.card K) hM)
+  have hX₂ : (W_smooth W).ordAtInfty (α₂.pullback (x_gen W)) =
+      ((-2 : ℤ) : WithTop ℤ) :=
+    ordAtInfty_mulByInt_neg_pullback_x_gen W s hs hsK
+  have hMdeep : (Fintype.card K : ℤ) * M < -2 := by nlinarith
+  have hxne : α₁.pullback (x_gen W) ≠ α₂.pullback (x_gen W) := by
+    intro heq
+    have horders := congrArg (W_smooth W).ordAtInfty heq
+    rw [hX₁, hX₂] at horders
+    have hint : (Fintype.card K : ℤ) * M = -2 := by exact_mod_cast horders
+    omega
+  have hpole : (W_smooth W).ordAtInfty (addPullback_x_pair α₁ α₂) < 0 :=
+    addPullback_x_pair_x_ord_neg W hxne
+      (by rw [hX₁]; exact_mod_cast (show (Fintype.card K : ℤ) * M < 0 by omega))
+      (by rw [hX₂]; exact_mod_cast (show (-2 : ℤ) < 0 by omega))
+  have hxy : AddNonInversePair α₁ α₂ := AddNonInversePair_of_x_ne hxne
+  have hinj : Function.Injective (addCoordAlgHomPair hxy) := by
+    apply addCoordAlgHomPair_injective_of_baseHom_inj
+    rw [addBaseHomPair_eq_aeval]
+    exact transcendental_iff_injective.mp (transcendental_of_negative_infinity_order W hpole)
+  let α := addIsog hxy hinj
+  have hαpole : (W_smooth W).ordAtInfty (α.pullback (x_gen W)) < 0 := by
+    change (W_smooth W).ordAtInfty ((addIsog hxy hinj).pullback (x_gen W)) < 0
+    rw [addIsog_pullback, OpenLemmaPrimitives.addPullbackAlgHomPair_x_gen_eq]
+    exact hpole
+  have hgen : IsGenuineWith W α
+      (((zsmulPointHom W r).comp (frobeniusW_KE W)) + zsmulPointHom W (-s)) :=
+    addIsog_isGenuineWith W hxy hinj
+      (zsmul_frobeniusIsog_isGenuineWith W r hr)
+      (mulByInt_isGenuineWith W (-s) (neg_ne_zero.mpr hs))
+  have hω₁ : omegaPullbackCoeff W α₁ = 0 := by
+    change omegaPullbackCoeff W ((mulByInt W.toAffine r).comp (frobeniusIsog W)) = 0
+    rw [omegaPullbackCoeff_comp_of_base W (mulByInt W.toAffine r) (frobeniusIsog W)
+      (r : K) (omegaPullbackCoeff_mulByInt_routeB W r hr), omegaPullbackCoeff_frobenius,
+      mul_zero]
+  have hω₂ : omegaPullbackCoeff W α₂ = algebraMap K W.toAffine.FunctionField (-s : K) := by
+    rw [show α₂ = mulByInt W.toAffine (-s) from rfl,
+      omegaPullbackCoeff_mulByInt_routeB W (-s) (neg_ne_zero.mpr hs), Int.cast_neg]
+  have hω : omegaPullbackCoeff W α = algebraMap K W.toAffine.FunctionField (-s : K) := by
+    rw [show α = addIsog hxy hinj from rfl, omegaPullbackCoeff_addIsog_pair W hxy hinj hxne,
+      hω₁, hω₂, zero_add]
+  obtain ⟨hx, hy⟩ := ordAtInfty_pullback_generators_of_nonzero_constant W α hαpole
+    (-s : K) (neg_ne_zero.mpr hsK) hω
+  exact ⟨α, hgen, hω, hx, hy⟩
