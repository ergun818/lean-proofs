+private theorem transcendental_of_negative_infinity_order [Finite K] {f : W.toAffine.FunctionField}
+    (hf : (W_smooth W).ordAtInfty f < 0) : Transcendental K f := by
+  classical
+  let : Fintype K := Fintype.ofFinite K
+  intro halg
+  let L := IntermediateField.adjoin K ({f} : Set W.toAffine.FunctionField)
+  have : FiniteDimensional K L := IntermediateField.adjoin.finiteDimensional halg.isIntegral
+  have : Finite L := Finite.of_injective (Module.finBasis K L).repr
+    (Module.finBasis K L).repr.injective
+  let : Fintype L := Fintype.ofFinite L
+  let a : L := ⟨f, IntermediateField.mem_adjoin_simple_self K f⟩
+  have hpow : f ^ Fintype.card L = f := by
+    have h := congrArg (fun z : L ↦ (z : W.toAffine.FunctionField)) (FiniteField.pow_card a)
+    exact h
+  have hfne : f ≠ 0 := ne_zero_of_ordAtInfty_neg W hf
+  obtain ⟨m, hm⟩ : ∃ m : ℤ, (W_smooth W).ordAtInfty f = (m : WithTop ℤ) := by
+    obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp
+      (((W_smooth W).ordAtInfty_eq_top_iff f).not.mpr hfne)
+    exact ⟨m, hm.symm⟩
+  have hmneg : m < 0 := by rw [hm] at hf; exact_mod_cast hf
+  have horder : (((Fintype.card L : ℤ) * m) : WithTop ℤ) = (m : WithTop ℤ) :=
+    ((W_smooth W).ord_pow_concrete hfne m (Fintype.card L) hm).symm.trans
+      ((congrArg (W_smooth W).ordAtInfty hpow).trans hm)
+  have hint : (Fintype.card L : ℤ) * m = m := by exact_mod_cast horder
+  have hcard : (1 : ℤ) < Fintype.card L := by
+    exact_mod_cast Fintype.one_lt_card_iff_nontrivial.mpr (inferInstance : Nontrivial L)
+  nlinarith
